# 信令服务监听端口
PORT=8787
# WebSocket 路径（反代时保持一致）
WS_PATH=/ws
# 配对码有效期（毫秒），需求固定 5 分钟
CODE_TTL_MS=300000

# STUN（公网打洞）。逗号分隔多个
STUN_URL=stun:stun.l.google.com:19302

# TURN（极端网络兜底中转）。指向你自己部署的 Coturn
# 可同时给 udp/tcp/tls 三个入口，逗号分隔
TURN_URL=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349
TURN_USERNAME=lts_friend
TURN_CREDENTIAL=change-me-to-a-long-random-secret

# 反代场景下信任 X-Forwarded-For（nginx/caddy 后设为 true）
TRUST_PROXY=true
