# ====== 前端编译期配置 ======
# 复制为 .env 后修改；npm run tauri:build / android:build 时会被打进安装包
# 你自己部署的信令服务器 WebSocket 地址（浏览器调试可用 ws://，正式请用 wss://）
VITE_SIGNAL_URL=wss://signal.example.com/ws

# 备用 STUN（公网打洞）。多个用英文逗号分隔；留空则使用信令服务器下发的配置
VITE_STUN_URL=stun:stun.l.google.com:19302

# 是否在浏览器 dev 模式下允许"模拟 OCR 结果"体验界面（默认 false；不会在 Tauri 包内出现）
VITE_OCR_DEMO=false
